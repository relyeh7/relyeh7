# Bitget Exchange API
BITGET_API_KEY=your_bitget_api_key
BITGET_API_SECRET=your_bitget_api_secret
BITGET_API_PASSPHRASE=your_bitget_api_passphrase

# Binance Exchange API
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# LLM APIs
ANTHROPIC_API_KEY=your_anthropic_api_key
GEMINI_API_KEY=your_gemini_api_key

# Infrastructure
REDIS_URL=redis://redis:6379
POSTGRES_URL=postgresql://algocore:algocore@postgres:5432/algocore

# Risk Management
MAX_DAILY_DRAWDOWN_PCT=6.0
STOP_ON_DRAWDOWN_PCT=6.0
MAX_EXPOSURE_PCT=90.0
DAILY_LOSS_LIMIT_PCT=5.0
INITIAL_EQUITY=10000.0

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Sentiment Analysis
CRYPTOPANIC_API_KEY=your_cryptopanic_api_key

# Trading Parameters
TRADING_SYMBOL=BTCUSDT
TRADING_SYMBOLS=["BTCUSDT"]
PAPER_TRADING=true

# Position Sizing & Risk per Trade
STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=4.0
KELLY_FRACTION=0.25

# Data Feed
FEED_POLL_SEC=30

# Dashboard Auth (leave empty to disable)
API_KEY=

# MLflow
MLFLOW_TRACKING_URI=mlruns
